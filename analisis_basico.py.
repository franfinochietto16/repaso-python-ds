# Tarea 4: Modularización con Funciones
# Función obligatoria: resumen_estadistico (recibe un solo parámetro)
def resumen_estadistico(numeros):
    # Calcula la suma, cantidad y promedio
    suma = sum(numeros)
    cantidad = len(numeros)
    promedio = suma / cantidad if cantidad > 0 else 0
    
    # Devuelve el diccionario solicitado
    return {
        "suma_total": suma,
        "promedio": promedio,
        "cantidad_elementos": cantidad
    }

# Llama a la función con una lista de ejemplo e imprime el resultado
lista_ejemplo = [10, 20, 30, 40, 50]
resultado = resumen_estadistico(lista_ejemplo)
print(f"El resumen estadístico es: {resultado}")
